DB_USERNAME=mpl_one
DB_PASSWORD=local-app-change-me
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-db-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me
DB_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:3000

KEYCLOAK_BFF_CLIENT_SECRET=
SESSION_COOKIE_SECURE=false
POST_LOGOUT_URI=http://localhost:8081/

# One-shot Keycloak Admin API synchronization (internal Docker network).
KEYCLOAK_CONFIG_URL=http://keycloak:8080
KEYCLOAK_CONFIG_FILES=/config/mpl-one-realm.json
# Optional separate operator credentials; empty falls back to KEYCLOAK_ADMIN*.
KEYCLOAK_CONFIG_ADMIN=
KEYCLOAK_CONFIG_ADMIN_PASSWORD=
# Only needed with docker-compose.keycloak-local.yml; never production.
KEYCLOAK_LOCAL_DEMO_PASSWORD=
